# ---------------------------------------------------------------------------
# Local environment. NEVER commit this file (see .gitignore).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database (MySQL / MariaDB) --------------------------------------------
# URL-encode special characters in the password (@ becomes %40), or the string
# parses wrong. Easiest to choose a password without @ : / ? # [ ] %
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"
# If your MySQL listens on a Unix socket rather than TCP (common on shared
# hosting), point at the socket and drop the port:
# DATABASE_URL="mysql://USER:PASSWORD@localhost/DATABASE?socket=/var/lib/mysql/mysql.sock"

# --- Auth ------------------------------------------------------------------
JWT_SECRET="generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))""
JWT_EXPIRES_IN=8h
COOKIE_NAME=websaf_admin
# Set to true when serving over HTTPS in production.
COOKIE_SECURE=false

# --- Image storage ---------------------------------------------------------
# Leave STORAGE_DRIVER=local to store uploads on disk during dev.
# Set STORAGE_DRIVER=cloudinary + the three keys below for cloud storage.
STORAGE_DRIVER=local
# Where local uploads are written. Defaults to public/uploads.
# IN PRODUCTION, on any host that builds each release into a new directory and
# deletes the old one, this MUST point outside the deployed tree -- otherwise
# every uploaded image is destroyed on the next deploy while its database row
# survives and 404s. The server warns at boot if this is misconfigured.
# UPLOAD_DIR=/home/you/persistent/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=websaf
MAX_UPLOAD_MB=5

# --- CORS ------------------------------------------------------------------
# Comma-separated list of origins allowed to call the public API.
# Empty = same-origin only (recommended).
CORS_ORIGINS=

# --- Geolocation -----------------------------------------------------------
# Reverse geocoding + IP fallback run server-side; both providers are keyless.
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=websaf-locator/1.0
IP_GEO_URL=https://ipwho.is
GEO_CACHE_TTL_MIN=720

# --- Lead email notifications ----------------------------------------------
# EMAIL_DRIVER picks the transport: "smtp", "resend" or "sendmail".
#
#   smtp     - any SMTP server, Gmail included. No domain verification needed,
#              so this works immediately. Gmail caps at roughly 500 mails/day.
#   resend   - Resend HTTP API. Better deliverability and a from-address on
#              your own domain, but the domain must be verified with Resend.
#   sendmail - hand the message to the host's own mail program. Needs no
#              account and no credential, but the mail is unsigned, so it is
#              filtered more often. A fallback, not a first choice.
#
# Left blank, the transport is chosen from whatever is actually usable: SMTP
# credentials, then a Resend key, then the host's mail program. Setting this
# overrides that. Leads are saved either way.
EMAIL_DRIVER=

# --- Gmail (EMAIL_DRIVER=smtp) ---------------------------------------------
# SMTP_PASS must be a Google App Password, NOT your normal account password:
# 2-Step Verification must be on, then create one at
# https://myaccount.google.com/apppasswords
# Host and port already default to Gmail, so these three are usually enough.
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM should use the same Gmail address, or Gmail rewrites the header.
# EMAIL_FROM="24x7 Customer Support <you@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Resend (EMAIL_DRIVER=resend) ------------------------------------------
# Server-side only. The key is never sent to the browser and never stored in
# the database. Leave blank to run without email — leads are still saved.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
EMAIL_FROM="24x7 Customer Support <leads@yourdomain.com>"
# Optional: where replies go when the lead left no email address.
EMAIL_REPLY_TO=
# Optional overrides.
# RESEND_API_URL=https://api.resend.com/emails
EMAIL_TIMEZONE=Asia/Kolkata
EMAIL_TIMEOUT_MS=10000

# --- Rate limits -----------------------------------------------------------
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_MIN=15
LEAD_RATE_MAX=5
LEAD_RATE_WINDOW_MIN=10
TEST_EMAIL_RATE_MAX=5
TEST_EMAIL_RATE_WINDOW_MIN=10

# --- First admin (used only by `npm run create:admin`) ---------------------
SEED_ADMIN_EMAIL=admin@24x7support.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
