# ---------------------------------------------------------------------------
# Local environment. NEVER commit this file (see .gitignore).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Paste your Neon / Supabase / self-hosted connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Auth ------------------------------------------------------------------
JWT_SECRET="generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))""
JWT_EXPIRES_IN=8h
COOKIE_NAME=websaf_admin
# Set to true when serving over HTTPS in production.
COOKIE_SECURE=false

# --- Image storage ---------------------------------------------------------
# Leave STORAGE_DRIVER=local to store uploads in public/uploads during dev.
# Set STORAGE_DRIVER=cloudinary + the three keys below for cloud storage.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=websaf
MAX_UPLOAD_MB=5

# --- CORS ------------------------------------------------------------------
# Comma-separated list of origins allowed to call the public API.
# Empty = same-origin only (recommended).
CORS_ORIGINS=

# --- Geolocation -----------------------------------------------------------
# Reverse geocoding + IP fallback run server-side; both providers are keyless.
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=websaf-locator/1.0
IP_GEO_URL=https://ipwho.is
GEO_CACHE_TTL_MIN=720

# --- Lead email notifications (Resend) -------------------------------------
# Server-side only. The key is never sent to the browser and never stored in
# the database. Leave blank to run without email — leads are still saved.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
EMAIL_FROM="24x7 Customer Support <leads@yourdomain.com>"
# Optional: where replies go when the lead left no email address.
EMAIL_REPLY_TO=
# Optional overrides.
# RESEND_API_URL=https://api.resend.com/emails
EMAIL_TIMEZONE=Asia/Kolkata
EMAIL_TIMEOUT_MS=10000

# --- Rate limits -----------------------------------------------------------
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_MIN=15
LEAD_RATE_MAX=5
LEAD_RATE_WINDOW_MIN=10
TEST_EMAIL_RATE_MAX=5
TEST_EMAIL_RATE_WINDOW_MIN=10

# --- First admin (used only by `npm run create:admin`) ---------------------
SEED_ADMIN_EMAIL=admin@24x7support.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
