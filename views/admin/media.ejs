<%- include('../partials/admin-head', { title: title, active: active, admin: admin }) %>

<div class="card-admin">
  <header>
    <h2>Upload image</h2>
    <div class="spacer"></div>
    <span class="pill <%= driver === 'cloudinary' ? 'on' : '' %>">
      Storage: <%= driver === 'cloudinary' ? 'Cloudinary' : 'Local disk' %>
    </span>
    <% if (driver === 'local') { %>
      <p>Uploads are written to the server directory set by <code>UPLOAD_DIR</code>, which is kept outside the deployed folder so images survive a redeploy. Set <code>STORAGE_DRIVER=cloudinary</code> plus the three Cloudinary keys to switch to cloud storage — existing records keep working.</p>
    <% } else { %>
      <p>Files are uploaded to Cloudinary. Only the URL and metadata are stored in the database.</p>
    <% } %>
  </header>
  <div class="card-body">
    <form id="uploadForm">
      <div class="grid-2">
        <div class="field">
          <label>Image file</label>
          <input type="file" name="file" accept="image/*" required/>
          <div class="hint">JPEG, PNG, WebP, GIF, AVIF, SVG or ICO. Max <%= 5 %> MB by default (MAX_UPLOAD_MB).</div>
        </div>
        <div class="field">
          <label>Alt text</label>
          <input type="text" name="alt" maxlength="200" placeholder="Describes the image for screen readers and SEO"/>
        </div>
      </div>
      <button type="submit" class="btn-a btn-primary-a"><i class="fa fa-upload"></i> Upload</button>
    </form>
  </div>
</div>

<div class="card-admin">
  <header>
    <h2><%= media.length %> file<%= media.length === 1 ? '' : 's' %></h2>
    <div class="spacer"></div>
    <p>Replacing a file keeps the same record, so every page already using it updates automatically.</p>
  </header>
  <div class="card-body">
    <% if (!media.length) { %>
      <div class="empty-state"><i class="fa fa-images"></i> No media yet. Upload your first image above.</div>
    <% } else { %>
    <div class="media-grid">
      <% media.forEach(function (m) { %>
      <div class="media-tile" data-media="<%= m.id %>">
        <div class="thumb" style="background-image:url('<%= m.url %>');"></div>
        <div class="meta">
          <div class="name"><%= m.filename %></div>
          <div class="sub">
            <%= m.provider %><%= m.width ? ' · ' + m.width + '×' + m.height : '' %><%= m.size ? ' · ' + Math.round(m.size / 1024) + ' KB' : '' %>
          </div>
          <div class="sub" style="margin-top:4px;"><em data-alt-label><%= m.alt || 'No alt text' %></em></div>
        </div>
        <div class="acts">
          <button class="btn-a btn-sm-a" data-copy="<%= m.url %>" title="Copy URL"><i class="fa fa-link"></i></button>
          <button class="btn-a btn-sm-a" data-edit-alt="<%= m.id %>" title="Edit alt text"><i class="fa fa-pen"></i></button>
          <button class="btn-a btn-sm-a" data-replace="<%= m.id %>" title="Replace image"><i class="fa fa-arrows-rotate"></i></button>
          <button class="btn-a btn-sm-a btn-danger-a" data-delete="<%= m.id %>"
                  data-confirm="Delete &quot;<%= m.filename %>&quot; permanently? Any page still using it will show a broken image."><i class="fa fa-trash"></i></button>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

<input type="file" id="replaceInput" accept="image/*" style="display:none;"/>

<%- include('../partials/admin-foot') %>

<script>
(function () {
  'use strict';
  var A = window.Admin;

  document.getElementById('uploadForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = e.target;
    var fd = new FormData(form);
    if (!fd.get('file') || !fd.get('file').size) { A.toast('Choose a file first.', 'err'); return; }
    var btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa fa-circle-notch fa-spin"></i> Uploading…';

    A.api('POST', '/api/admin/media', fd, true)
      .then(function () { A.toast('Uploaded', 'ok'); setTimeout(function () { location.reload(); }, 500); })
      .catch(function (err) {
        A.toast(err.message, 'err');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa fa-upload"></i> Upload';
      });
  });

  document.querySelectorAll('[data-copy]').forEach(function (b) {
    b.addEventListener('click', function () {
      var url = b.getAttribute('data-copy');
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function () { A.toast('URL copied', 'ok'); });
      } else {
        window.prompt('Copy this URL:', url);
      }
    });
  });

  document.querySelectorAll('[data-edit-alt]').forEach(function (b) {
    b.addEventListener('click', function () {
      var id = b.getAttribute('data-edit-alt');
      var tile = document.querySelector('[data-media="' + id + '"]');
      var current = tile.querySelector('[data-alt-label]').textContent;
      var next = window.prompt('Alt text for this image:', current === 'No alt text' ? '' : current);
      if (next === null) return;
      var fd = new FormData();
      fd.append('alt', next);
      A.api('PUT', '/api/admin/media/' + id, fd, true)
        .then(function (m) {
          tile.querySelector('[data-alt-label]').textContent = m.alt || 'No alt text';
          A.toast('Alt text saved', 'ok');
        })
        .catch(function (e) { A.toast(e.message, 'err'); });
    });
  });

  var replaceInput = document.getElementById('replaceInput');
  var replacingId = null;
  document.querySelectorAll('[data-replace]').forEach(function (b) {
    b.addEventListener('click', function () {
      replacingId = b.getAttribute('data-replace');
      replaceInput.value = '';
      replaceInput.click();
    });
  });
  replaceInput.addEventListener('change', function () {
    if (!replaceInput.files.length || !replacingId) return;
    var fd = new FormData();
    fd.append('file', replaceInput.files[0]);
    A.api('PUT', '/api/admin/media/' + replacingId, fd, true)
      .then(function () { A.toast('Image replaced — the website now shows the new file.', 'ok'); setTimeout(function () { location.reload(); }, 700); })
      .catch(function (e) { A.toast(e.message, 'err'); });
  });

  document.querySelectorAll('[data-delete]').forEach(function (b) {
    b.addEventListener('click', function () {
      A.api('DELETE', '/api/admin/media/' + b.getAttribute('data-delete'))
        .then(function () { A.toast('Deleted', 'ok'); setTimeout(function () { location.reload(); }, 400); })
        .catch(function (e) { A.toast(e.message, 'err'); });
    });
  });
})();
</script>
<%- include("../partials/admin-end") %>
