<script>
(function () {
  'use strict';
  var A = window.Admin;

  // Media pickers inside any image-picker block.
  document.addEventListener('change', function (e) {
    var sel = e.target.closest('[data-media-picker]');
    if (!sel || !sel.value) return;
    var picker = sel.closest('.image-picker');
    if (!picker) return;
    var input = picker.querySelector('[data-image-input]');
    var preview = picker.querySelector('[data-preview]');
    if (input) input.value = sel.value;
    if (preview) {
      preview.style.backgroundImage = "url('" + sel.value.replace(/'/g, "\\'") + "')";
      preview.innerHTML = '';
    }
    sel.value = '';
  });

  // Live preview when an image URL is typed.
  document.addEventListener('input', function (e) {
    var input = e.target.closest('[data-image-input]');
    if (!input) return;
    var picker = input.closest('.image-picker');
    var preview = picker && picker.querySelector('[data-preview]');
    if (!preview) return;
    preview.style.backgroundImage = input.value ? "url('" + input.value.replace(/'/g, "\\'") + "')" : '';
    preview.innerHTML = input.value ? '' : '<i class="fa fa-image"></i>';
  });

  /** Build the section payload: plain fields + every named repeat group. */
  function buildContent(card) {
    var content = A.collectFields(card);
    card.querySelectorAll('[data-repeat]').forEach(function (group) {
      var name = group.getAttribute('data-repeat-name');
      if (!name) return;
      var items = A.collectRepeat(group);
      // "order" is meaningful for steps; elsewhere array position is enough.
      if (name !== 'steps') {
        items = items.map(function (o) { delete o.order; return o; });
      }
      content[name] = items;
    });
    return content;
  }

  document.querySelectorAll('[data-save-section]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var card = btn.closest('[data-section]');
      var key = card.getAttribute('data-section');
      var original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa fa-circle-notch fa-spin"></i> Saving…';

      A.api('PUT', '/api/admin/sections/' + key, { content: buildContent(card) })
        .then(function () { A.toast('Saved — the website is updated.', 'ok'); })
        .catch(function (err) { A.toast(err.message, 'err'); })
        .finally(function () {
          btn.disabled = false;
          btn.innerHTML = original;
        });
    });
  });
})();
</script>
