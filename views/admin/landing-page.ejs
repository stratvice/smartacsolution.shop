<%
  function c(key) { return (byKey[key] && byKey[key].content) || {}; }
  var hero = c('hero'), about = c('about'), why = c('why'), proc = c('process');
  var svcHead = c('services_header'), testiHead = c('testimonials_header'), faqHead = c('faq_header');
  var contact = c('contact'), footer = c('footer'), topbar = c('topbar'), ticker = c('ticker');
  function v(o, k, d) { return o[k] === undefined || o[k] === null ? (d === undefined ? '' : d) : o[k]; }
%>
<%- include('../partials/admin-head', { title: title, active: active, admin: admin }) %>

<div class="card-admin">
  <div class="card-body" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
    <i class="fa fa-circle-info" style="color:var(--teal);font-size:1.1rem;"></i>
    <div style="flex:1;min-width:240px;font-size:.88rem;">
      Every field here is live on the public site the moment you save.
      Use <code>{{city}}</code>, <code>{{state}}</code> or <code>{{country}}</code> anywhere in a heading or description
      to insert the visitor's detected location — e.g. <em>AC Repair Services in {{city}}</em>.
    </div>
    <a class="btn-a btn-sm-a" href="/" target="_blank"><i class="fa fa-arrow-up-right-from-square"></i> Preview</a>
  </div>
</div>

<!-- =============================================================== TOP BAR -->
<div class="card-admin" data-section="topbar">
  <header>
    <h2><i class="fa fa-grip-lines"></i> Top Bar</h2>
    <div class="spacer"></div>
    <button class="btn-a btn-sm-a btn-primary-a" data-save-section><i class="fa fa-floppy-disk"></i> Save</button>
    <p>Contact details themselves live in <a href="/admin/settings">Settings → Contact</a>.</p>
  </header>
  <div class="card-body">
    <div class="grid-2">
      <div class="field"><label class="check"><input type="checkbox" data-key="showPhone" <%= v(topbar,'showPhone',true) !== false ? 'checked' : '' %>/> Show phone</label></div>
      <div class="field"><label class="check"><input type="checkbox" data-key="showEmail" <%= v(topbar,'showEmail',true) !== false ? 'checked' : '' %>/> Show email</label></div>
      <div class="field"><label class="check"><input type="checkbox" data-key="showLocation" <%= v(topbar,'showLocation',true) !== false ? 'checked' : '' %>/> Show location</label></div>
      <div class="field"><label class="check"><input type="checkbox" data-key="showHours" <%= v(topbar,'showHours',true) !== false ? 'checked' : '' %>/> Show working hours</label></div>
    </div>
  </div>
</div>

<!-- ================================================================== HERO -->
<div class="card-admin" data-section="hero">
  <header>
    <h2><i class="fa fa-star"></i> Hero</h2>
    <div class="spacer"></div>
    <button class="btn-a btn-sm-a btn-primary-a" data-save-section><i class="fa fa-floppy-disk"></i> Save</button>
  </header>
  <div class="card-body">
    <div class="grid-2">
      <div class="field">
        <label>Badge text</label>
        <input type="text" data-key="badge" value="<%= v(hero,'badge') %>" maxlength="200"/>
        <div class="hint">Supports {{city}} — currently: "<%= v(hero,'badge') %>"</div>
      </div>
      <div class="field">
        <label>Badge icon</label>
        <input type="text" data-key="badgeIcon" value="<%= v(hero,'badgeIcon') %>" maxlength="80"/>
      </div>
    </div>

    <div class="field">
      <label>Heading</label>
      <div class="grid-3">
        <input type="text" data-key="heading" value="<%= v(hero,'heading') %>" placeholder="Your Trusted" maxlength="120"/>
        <input type="text" data-key="highlight1" value="<%= v(hero,'highlight1') %>" placeholder="Repair (orange)" maxlength="120"/>
        <input type="text" data-key="connector" value="<%= v(hero,'connector') %>" placeholder="&amp;" maxlength="20"/>
      </div>
      <div class="grid-2" style="margin-top:8px;">
        <input type="text" data-key="highlight2" value="<%= v(hero,'highlight2') %>" placeholder="Ac Service (teal)" maxlength="120"/>
        <input type="text" data-key="headingSuffix" value="<%= v(hero,'headingSuffix') %>" placeholder="Experts" maxlength="120"/>
      </div>
      <div class="hint">Renders as: <strong><%= v(hero,'heading') %></strong> <em>highlight 1</em> <%= v(hero,'connector') %> <em>highlight 2</em> <strong><%= v(hero,'headingSuffix') %></strong></div>
    </div>

    <div class="field">
      <label>Description</label>
      <textarea data-key="description" rows="3" maxlength="1000"><%= v(hero,'description') %></textarea>
    </div>

    <div class="field">
      <label>Hero image</label>
      <div class="image-picker">
        <div class="preview" data-preview style="<% if (v(hero,'imageUrl')) { %>background-image:url('<%= v(hero,'imageUrl') %>');<% } %>"><%- v(hero,'imageUrl') ? '' : '<i class="fa fa-image"></i>' %></div>
        <div class="picker-body">
          <input type="text" data-key="imageUrl" data-image-input value="<%= v(hero,'imageUrl') %>" maxlength="600"/>
          <div class="btn-row" style="margin-top:7px;">
            <select data-media-picker style="max-width:230px;">
              <option value="">Pick from media library…</option>
              <% media.forEach(function (m) { %><option value="<%= m.url %>"><%= m.filename %></option><% }); %>
            </select>
            <a class="btn-a btn-sm-a" href="/admin/media" target="_blank"><i class="fa fa-upload"></i> Upload</a>
          </div>
        </div>
      </div>
    </div>
    <div class="field">
      <label>Image alt text</label>
      <input type="text" data-key="imageAlt" value="<%= v(hero,'imageAlt') %>" maxlength="200"/>
    </div>

    <div class="grid-3">
      <div class="field">
        <label>Primary button text</label>
        <input type="text" data-key="primaryBtnText" value="<%= v(hero,'primaryBtnText') %>" maxlength="60"/>
      </div>
      <div class="field">
        <label>Primary button link</label>
        <input type="text" data-key="primaryBtnLink" value="<%= v(hero,'primaryBtnLink') %>" maxlength="600"/>
      </div>
      <div class="field">
        <label>Primary button icon</label>
        <input type="text" data-key="primaryBtnIcon" value="<%= v(hero,'primaryBtnIcon') %>" maxlength="80"/>
      </div>
    </div>
    <div class="grid-3">
      <div class="field">
        <label>Secondary button text</label>
        <input type="text" data-key="secondaryBtnText" value="<%= v(hero,'secondaryBtnText') %>" maxlength="60"/>
      </div>
      <div class="field">
        <label>Secondary button link</label>
        <input type="text" data-key="secondaryBtnLink" value="<%= v(hero,'secondaryBtnLink') %>" maxlength="600"/>
      </div>
      <div class="field">
        <label>Secondary button icon</label>
        <input type="text" data-key="secondaryBtnIcon" value="<%= v(hero,'secondaryBtnIcon') %>" maxlength="80"/>
      </div>
    </div>

    <div data-repeat data-repeat-name="stats">
      <label style="display:block;font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin-bottom:7px;">Hero statistics</label>
      <div data-repeat-list>
        <% (hero.stats || []).forEach(function (st, i) { %>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#<%= i + 1 %></strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="grid-3">
            <div class="field"><label>Value</label><input type="number" data-key="value" data-number="1" value="<%= st.value %>"/></div>
            <div class="field"><label>Label</label><input type="text" data-key="label" value="<%= st.label %>" maxlength="60"/></div>
            <div class="field"><label>Style</label><label class="check"><input type="checkbox" data-key="accent" <%= st.accent ? 'checked' : '' %>/> Teal accent</label></div>
          </div>
        </div>
        <% }); %>
      </div>
      <template data-repeat-template>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#</strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="grid-3">
            <div class="field"><label>Value</label><input type="number" data-key="value" data-number="1" value="0"/></div>
            <div class="field"><label>Label</label><input type="text" data-key="label" value="" maxlength="60"/></div>
            <div class="field"><label>Style</label><label class="check"><input type="checkbox" data-key="accent"/> Teal accent</label></div>
          </div>
        </div>
      </template>
      <button type="button" class="btn-a btn-sm-a" data-repeat-add><i class="fa fa-plus"></i> Add statistic</button>
    </div>
  </div>
</div>

<!-- ================================================================ TICKER -->
<div class="card-admin" data-section="ticker">
  <header>
    <h2><i class="fa fa-arrows-left-right"></i> Scrolling Ticker</h2>
    <div class="spacer"></div>
    <button class="btn-a btn-sm-a btn-primary-a" data-save-section><i class="fa fa-floppy-disk"></i> Save</button>
  </header>
  <div class="card-body">
    <div data-repeat data-repeat-name="items">
      <div data-repeat-list>
        <% (ticker.items || []).forEach(function (it, i) { %>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#<%= i + 1 %></strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="grid-2">
            <div class="field"><label>Icon</label><input type="text" data-key="icon" value="<%= it.icon %>" maxlength="80"/></div>
            <div class="field"><label>Text</label><input type="text" data-key="text" value="<%= it.text %>" maxlength="120"/></div>
          </div>
        </div>
        <% }); %>
      </div>
      <template data-repeat-template>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#</strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="grid-2">
            <div class="field"><label>Icon</label><input type="text" data-key="icon" value="fa fa-check-circle" maxlength="80"/></div>
            <div class="field"><label>Text</label><input type="text" data-key="text" value="" maxlength="120"/></div>
          </div>
        </div>
      </template>
      <button type="button" class="btn-a btn-sm-a" data-repeat-add><i class="fa fa-plus"></i> Add ticker item</button>
    </div>
  </div>
</div>

<!-- ======================================================= WELCOME / ABOUT -->
<div class="card-admin" data-section="about">
  <header>
    <h2><i class="fa fa-address-card"></i> Welcome / About</h2>
    <div class="spacer"></div>
    <button class="btn-a btn-sm-a btn-primary-a" data-save-section><i class="fa fa-floppy-disk"></i> Save</button>
  </header>
  <div class="card-body">
    <div class="grid-2">
      <div class="field"><label>Badge</label><input type="text" data-key="badge" value="<%= v(about,'badge') %>" maxlength="120"/></div>
      <div class="field"><label>Badge icon</label><input type="text" data-key="badgeIcon" value="<%= v(about,'badgeIcon') %>" maxlength="80"/></div>
    </div>
    <div class="field">
      <label>Heading</label>
      <div class="grid-3">
        <input type="text" data-key="heading" value="<%= v(about,'heading') %>" placeholder="Welcome to" maxlength="120"/>
        <input type="text" data-key="highlight" value="<%= v(about,'highlight') %>" placeholder="Highlighted (orange)" maxlength="120"/>
        <input type="text" data-key="headingSuffix" value="<%= v(about,'headingSuffix') %>" placeholder="Service" maxlength="120"/>
      </div>
    </div>
    <div class="field">
      <label>Description</label>
      <textarea data-key="description" rows="5" maxlength="3000"><%= v(about,'description') %></textarea>
    </div>

    <div data-repeat data-repeat-name="images">
      <label style="display:block;font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin-bottom:7px;">Image grid</label>
      <div data-repeat-list>
        <% (about.images || []).forEach(function (img, i) { %>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#<%= i + 1 %></strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="image-picker">
            <div class="preview" data-preview style="background-image:url('<%= img.url %>');"></div>
            <div class="picker-body">
              <div class="field"><label>Image URL</label><input type="text" data-key="url" data-image-input value="<%= img.url %>" maxlength="600"/></div>
              <div class="field"><label>Alt text</label><input type="text" data-key="alt" value="<%= img.alt || '' %>" maxlength="200"/></div>
              <select data-media-picker style="max-width:230px;">
                <option value="">Pick from media library…</option>
                <% media.forEach(function (m) { %><option value="<%= m.url %>"><%= m.filename %></option><% }); %>
              </select>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <template data-repeat-template>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#</strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="image-picker">
            <div class="preview" data-preview><i class="fa fa-image"></i></div>
            <div class="picker-body">
              <div class="field"><label>Image URL</label><input type="text" data-key="url" data-image-input value="" maxlength="600"/></div>
              <div class="field"><label>Alt text</label><input type="text" data-key="alt" value="" maxlength="200"/></div>
              <select data-media-picker style="max-width:230px;">
                <option value="">Pick from media library…</option>
                <% media.forEach(function (m) { %><option value="<%= m.url %>"><%= m.filename %></option><% }); %>
              </select>
            </div>
          </div>
        </div>
      </template>
      <button type="button" class="btn-a btn-sm-a" data-repeat-add><i class="fa fa-plus"></i> Add image</button>
    </div>

    <div data-repeat data-repeat-name="features" style="margin-top:18px;">
      <label style="display:block;font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin-bottom:7px;">Feature items</label>
      <div data-repeat-list>
        <% (about.features || []).forEach(function (f, i) { %>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#<%= i + 1 %></strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="grid-2">
            <div class="field"><label>Icon</label><input type="text" data-key="icon" value="<%= f.icon %>" maxlength="80"/></div>
            <div class="field"><label>Icon colour</label>
              <select data-key="style">
                <option value="icon-orange" <%= f.style === 'icon-orange' ? 'selected' : '' %>>Orange</option>
                <option value="icon-teal" <%= f.style === 'icon-teal' ? 'selected' : '' %>>Teal</option>
              </select>
            </div>
          </div>
          <div class="field"><label>Title</label><input type="text" data-key="title" value="<%= f.title %>" maxlength="160"/></div>
          <div class="field"><label>Description</label><textarea data-key="description" rows="2" maxlength="600"><%= f.description %></textarea></div>
        </div>
        <% }); %>
      </div>
      <template data-repeat-template>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#</strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="grid-2">
            <div class="field"><label>Icon</label><input type="text" data-key="icon" value="fa fa-check" maxlength="80"/></div>
            <div class="field"><label>Icon colour</label>
              <select data-key="style"><option value="icon-orange">Orange</option><option value="icon-teal">Teal</option></select>
            </div>
          </div>
          <div class="field"><label>Title</label><input type="text" data-key="title" value="" maxlength="160"/></div>
          <div class="field"><label>Description</label><textarea data-key="description" rows="2" maxlength="600"></textarea></div>
        </div>
      </template>
      <button type="button" class="btn-a btn-sm-a" data-repeat-add><i class="fa fa-plus"></i> Add feature</button>
    </div>

    <div data-repeat data-repeat-name="stats" style="margin-top:18px;">
      <label style="display:block;font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin-bottom:7px;">Statistics</label>
      <div data-repeat-list>
        <% (about.stats || []).forEach(function (st, i) { %>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#<%= i + 1 %></strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="grid-2">
            <div class="field"><label>Value</label><input type="number" data-key="value" data-number="1" value="<%= st.value %>"/></div>
            <div class="field"><label>Label</label><input type="text" data-key="label" value="<%= st.label %>" maxlength="60"/></div>
          </div>
        </div>
        <% }); %>
      </div>
      <template data-repeat-template>
        <div class="repeat-item">
          <div class="repeat-head">
            <strong data-repeat-index>#</strong>
            <div class="spacer"></div>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-up><i class="fa fa-arrow-up"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon" data-repeat-down><i class="fa fa-arrow-down"></i></button>
            <button type="button" class="btn-a btn-sm-a btn-icon btn-danger-a" data-repeat-remove><i class="fa fa-trash"></i></button>
          </div>
          <div class="grid-2">
            <div class="field"><label>Value</label><input type="number" data-key="value" data-number="1" value="0"/></div>
            <div class="field"><label>Label</label><input type="text" data-key="label" value="" maxlength="60"/></div>
          </div>
        </div>
      </template>
      <button type="button" class="btn-a btn-sm-a" data-repeat-add><i class="fa fa-plus"></i> Add statistic</button>
    </div>

    <div class="grid-2" style="margin-top:18px;">
      <div class="field"><label>Button text <span class="hint">(blank = hidden)</span></label><input type="text" data-key="buttonText" value="<%= v(about,'buttonText') %>" maxlength="60"/></div>
      <div class="field"><label>Button link</label><input type="text" data-key="buttonLink" value="<%= v(about,'buttonLink') %>" maxlength="600"/></div>
    </div>
  </div>
</div>

<!-- ====================================================== SERVICES HEADING -->
<div class="card-admin" data-section="services_header">
  <header>
    <h2><i class="fa fa-heading"></i> Services — heading</h2>
    <div class="spacer"></div>
    <button class="btn-a btn-sm-a btn-primary-a" data-save-section><i class="fa fa-floppy-disk"></i> Save</button>
    <p>The service cards themselves are managed in <a href="/admin/services">Services</a>.</p>
  </header>
  <div class="card-body">
    <div class="grid-2">
      <div class="field"><label>Badge</label><input type="text" data-key="badge" value="<%= v(svcHead,'badge') %>" maxlength="120"/></div>
      <div class="field"><label>Badge icon</label><input type="text" data-key="badgeIcon" value="<%= v(svcHead,'badgeIcon') %>" maxlength="80"/></div>
    </div>
    <div class="grid-2">
      <div class="field"><label>Heading</label><input type="text" data-key="heading" value="<%= v(svcHead,'heading') %>" maxlength="160"/><div class="hint">Supports {{city}} — e.g. "AC Repair Services in {{city}}"</div></div>
      <div class="field"><label>Highlighted word</label><input type="text" data-key="highlight" value="<%= v(svcHead,'highlight') %>" maxlength="120"/></div>
    </div>
  </div>
</div>

<!-- ======================================================== WHY CHOOSE US -->
<div class="card-admin" data-section="why">
  <header>
    <h2><i class="fa fa-trophy"></i> Why Choose Us</h2>
    <div class="spacer"></div>
    <button class="btn-a btn-sm-a btn-primary-a" data-save-section><i class="fa fa-floppy-disk"></i> Save</button>
  </header>
  <div class="card-body">
