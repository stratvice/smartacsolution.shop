<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Page not found</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
           background:linear-gradient(135deg,#0c2b47,#052d45); color:#fff;
           font-family:'DM Sans',system-ui,sans-serif; text-align:center; padding:24px; }
    .code { font-family:'Barlow Condensed',sans-serif; font-size:7rem; line-height:1; color:#ff9800; font-weight:800; }
    h1 { font-family:'Barlow Condensed',sans-serif; font-size:2rem; margin:6px 0 10px; }
    p { color:rgba(255,255,255,.7); margin:0 0 22px; }
    a { display:inline-flex; align-items:center; gap:8px; background:#ff9800; color:#fff;
        padding:11px 22px; border-radius:10px; text-decoration:none; font-weight:700; }
  </style>
</head>
<body>
  <div>
    <div class="code">404</div>
    <h1>Page not found</h1>
    <p>The page you are looking for doesn't exist or has moved.</p>
    <a href="/"><i class="fa fa-house"></i> Back to the website</a>
  </div>
</body>
</html>
