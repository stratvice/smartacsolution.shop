  "version": "1.0.0",
  "private": true,
  "description": "24x7 Customer Support - dynamic landing site with admin CMS and lead management",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
